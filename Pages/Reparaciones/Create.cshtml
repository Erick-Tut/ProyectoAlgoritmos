@page "{activoId:int}"
@model ProyectoAlgoritmos.Pages.Reparaciones.CreateModel

@{
    ViewData["Title"] = "Registrar reparación";
}

<div class="page-heading">
    <div>
        <span class="eyebrow">ACTIVOS / REPARACIONES</span>
        <h1>Registrar reparación</h1>
        <p>Registra el ingreso, diagnóstico, costos y entrega del equipo.</p>
    </div>
</div>

@if (Model.Activo != null)
{
    <section class="content-card selected-asset">
        <div class="card-heading">
            <div>
                <h2>Activo seleccionado</h2>
                <p>La reparación quedará asociada a este equipo.</p>
            </div>
            <span class="status-label">Activo</span>
        </div>
        <div class="selected-asset-grid">
            <div><span class="detail-label">Código del activo</span><strong>@Model.Activo.CodigoActivo</strong></div>
            <div><span class="detail-label">Marca y modelo</span><strong>@Model.Activo.Marca @Model.Activo.Modelo</strong></div>
            <div><span class="detail-label">Fecha de registro</span><strong>@Model.Activo.FechaIngreso.ToString("dd/MM/yyyy")</strong></div>
        </div>
    </section>

    <form method="post" class="form-card">
        <div asp-validation-summary="All" class="validation-summary-errors"></div>
        <input type="hidden" asp-for="Reparacion.ActivoId" />

        <section class="form-section">
            <div class="form-section-heading">
                <h2>Información de la reparación</h2>
                <p>Describe el trabajo realizado y quién lo efectuó.</p>
            </div>
            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="Reparacion.FechaReparacion">Fecha de reparación</label>
                    <input asp-for="Reparacion.FechaReparacion" type="date" />
                    <span class="field-hint">No puede ser anterior al registro ni a la compra del activo.</span>
                    <span asp-validation-for="Reparacion.FechaReparacion" class="field-validation-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Reparacion.Proveedor">Proveedor</label>
                    <input asp-for="Reparacion.Proveedor" placeholder="Nombre del proveedor" />
                    <span asp-validation-for="Reparacion.Proveedor" class="field-validation-error"></span>
                </div>
                <div class="form-group full-width">
                    <label asp-for="Reparacion.Diagnostico">Diagnóstico</label>
                    <textarea asp-for="Reparacion.Diagnostico" rows="4" placeholder="Describe el problema encontrado y el trabajo realizado."></textarea>
                    <span asp-validation-for="Reparacion.Diagnostico" class="field-validation-error"></span>
                </div>
            </div>
        </section>

        <section class="form-section">
            <div class="form-section-heading">
                <h2>Factura y costos</h2>
                <p>Información del comprobante y el monto de la reparación.</p>
            </div>
            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="Reparacion.Factura">Número de factura</label>
                    <input asp-for="Reparacion.Factura" placeholder="Número de factura" />
                    <span asp-validation-for="Reparacion.Factura" class="field-validation-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Reparacion.FechaFactura">Fecha de factura</label>
                    <input asp-for="Reparacion.FechaFactura" type="date" />
                    <span asp-validation-for="Reparacion.FechaFactura" class="field-validation-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Reparacion.Monto">Monto de la reparación (Q)</label>
                    <input asp-for="Reparacion.Monto" type="number" min="0" step="0.01" placeholder="0.00" />
                    <span asp-validation-for="Reparacion.Monto" class="field-validation-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Reparacion.FechaEntregaUsuario">Fecha de entrega al usuario</label>
                    <input asp-for="Reparacion.FechaEntregaUsuario" type="date" />
                    <span asp-validation-for="Reparacion.FechaEntregaUsuario" class="field-validation-error"></span>
                </div>
            </div>
        </section>

        <div class="form-actions">
            <a asp-page="/Activos/Detalles" asp-route-id="@Model.Activo.Id" class="button button-secondary">Cancelar</a>
            <button type="submit" class="button button-primary">Registrar reparación</button>
        </div>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
